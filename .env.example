# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (phase 3): Project Settings -> API Keys, and the project URL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (seed script locally; extraction job on Vercel). Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Inngest (phase 4): locally just INNGEST_DEV=1 and run `npm run inngest`.
# On Vercel: INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY (the Inngest Vercel integration sets them).
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Later phases:
# ANTHROPIC_API_KEY=
